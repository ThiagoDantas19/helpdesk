SECRET_KEY="sua-chave-secreta-aqui-mude-em-producao"

# Fuso horário da aplicação (exibição de logs, chamados, auditorias e CSVs).
# Os timestamps são sempre armazenados em UTC no banco e convertidos aqui na exibição.
# APP_TIMEZONE="America/Sao_Paulo"

# Cache: SimpleCache (padrão, por processo) ou RedisCache para multi-worker
# CACHE_TYPE="RedisCache"
# CACHE_REDIS_URL="redis://localhost:6379/0"
